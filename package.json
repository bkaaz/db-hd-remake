{
  "name": "db-hd-remake",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fan remake (browser, TypeScript) of Dragon Ball Z: Hyper Dimension (SNES, 1996). Non-commercial.",
  "scripts": {
    "dev": "vite",
    "editor": "vite --port 5174 --open /tools/entity-editor/",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "hash-assets": "node scripts/fetch-assets.mjs --print-hashes",
    "build": "tsc --noEmit && vite build",
    "anim": "tsx scripts/anim.ts",
    "fx": "tsx scripts/fx.ts",
    "split-audio": "tsx scripts/split-audio.ts",
    "sheet": "tsx scripts/sheet.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pixi.js": "^8.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.23.11",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
