# Claude Code: skills are project work and are committed; local machine
# settings (granted permissions) are not.
.claude/settings.local.json

# Nothing of the original enters git: the game reads the player's own ROM
# (ADR 0090), and only code and data/ are committed.
#
#   raw/       the cartridge (raw/rom/, ROM_PATH in .env.local) and the save
#              states npm run original plays from (raw/states/)
#   preview/   images a script rendered for a person to look at, never read back
raw/
preview/

# Gameplay recordings (src/log.ts) — a scratch file for debugging a session,
# rewritten every time recording starts.
logs/
