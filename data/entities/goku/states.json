{
  "initial": "idle",
  "onGotHit": "hurt",
  "states": {
    "idle": {
      "anim": "idle",
      "vel": [0, 0],
      "turn": true,
      "transitions": [
        { "when": "pressed:punch", "to": "punch" },
        { "when": "pressed:kick", "to": "kick" },
        { "when": "pressed:punchHeavy", "to": "uppercut" },
        { "when": "pressed:kickHeavy", "to": "kick_heavy" },
        { "when": "held:fwd", "to": "walk_fwd" },
        { "when": "held:back", "to": "walk_back" },
        { "when": "held:up", "to": "jump_up" },
        { "when": "held:down", "to": "crouch" }
      ]
    },
    "walk_fwd": {
      "anim": "walk",
      "vel": [1.4, 0],
      "turn": true,
      "transitions": [
        { "when": "pressed:punch", "to": "punch" },
        { "when": "pressed:kick", "to": "kick" },
        { "when": "pressed:punchHeavy", "to": "uppercut" },
        { "when": "pressed:kickHeavy", "to": "kick_heavy" },
        { "when": "held:up", "to": "jump_fwd" },
        { "when": "!held:fwd", "to": "idle" },
        { "when": "held:down", "to": "crouch" }
      ]
    },
    "walk_back": {
      "anim": "walk",
      "vel": [-1.0, 0],
      "turn": true,
      "transitions": [
        { "when": "pressed:punch", "to": "punch" },
        { "when": "pressed:kick", "to": "kick" },
        { "when": "pressed:punchHeavy", "to": "uppercut" },
        { "when": "pressed:kickHeavy", "to": "kick_heavy" },
        { "when": "held:up", "to": "jump_back" },
        { "when": "!held:back", "to": "idle" },
        { "when": "held:down", "to": "crouch" }
      ]
    },
    "punch": {
      "anim": "punch",
      "vel": [0, 0],
      "turn": false,
      "onHit": "hurt",
      "transitions": [
        { "when": "animEnd", "to": "idle" }
      ]
    },
    "kick": {
      "anim": "kick",
      "vel": [0, 0],
      "turn": false,
      "onHit": "hurt",
      "transitions": [
        { "when": "animEnd", "to": "idle" }
      ]
    },
    "uppercut": {
      "anim": "uppercut",
      "vel": [0, 0],
      "turn": false,
      "onHit": "knockdown",
      "hitFx": "fx_hit_heavy",
      "transitions": [
        { "when": "animEnd", "to": "idle" }
      ]
    },
    "kick_heavy": {
      "anim": "kick_heavy",
      "vel": [0, 0],
      "turn": false,
      "onHit": "hurt_heavy",
      "hitFx": "fx_hit_heavy",
      "transitions": [
        { "when": "animEnd", "to": "idle" }
      ]
    },
    "crouch": {
      "anim": "crouch",
      "vel": [0, 0],
      "turn": true,
      "transitions": [
        { "when": "pressed:kick", "to": "kick_crouch" },
        { "when": "!held:down", "to": "idle" }
      ]
    },
    "kick_crouch": {
      "anim": "kick_crouch",
      "vel": [0, 0],
      "turn": false,
      "onHit": "hurt",
      "transitions": [
        { "when": "animEnd", "to": "crouch" }
      ]
    },
    "hurt": {
      "anim": "hurt",
      "vel": [-1.4, 0],
      "turn": false,
      "transitions": [
        { "when": "animEnd", "to": "idle" }
      ]
    },
    "hurt_heavy": {
      "anim": "hurt_heavy",
      "vel": [-5.2, 0],
      "turn": false,
      "transitions": [
        { "when": "animEnd", "to": "idle" }
      ]
    },
    "knockdown": {
      "anim": "knockdown",
      "launch": [-1.0, -6.2],
      "airborne": true,
      "turn": false,
      "transitions": [
        { "when": "landed", "to": "downed" }
      ]
    },
    "downed": {
      "anim": "downed",
      "vel": [0, 0],
      "turn": false,
      "transitions": [
        { "when": "animEnd", "to": "getup" }
      ]
    },
    "getup": {
      "anim": "getup",
      "vel": [0, 0],
      "turn": false,
      "transitions": [
        { "when": "animEnd", "to": "idle" }
      ]
    },
    "jump_up": {
      "anim": "jump_up",
      "launch": [0, -7.8],
      "airborne": true,
      "turn": false,
      "transitions": [
        { "when": "nearGround", "to": "land" },
        { "when": "falling", "to": "jump_up_fall" },
        { "when": "landed", "to": "idle" }
      ]
    },
    "jump_fwd": {
      "anim": "jump_fwd",
      "launch": [2.3, -7.8],
      "airborne": true,
      "turn": false,
      "transitions": [
        { "when": "nearGround", "to": "land" },
        { "when": "animEnd", "to": "jump_fwd_air" },
        { "when": "landed", "to": "idle" }
      ]
    },
    "jump_fwd_air": {
      "anim": "jump_spin",
      "airborne": true,
      "turn": false,
      "transitions": [
        { "when": "nearGround", "to": "land" },
        { "when": "animEnd", "to": "fall" },
        { "when": "landed", "to": "idle" }
      ]
    },
    "jump_back": {
      "anim": "jump_back",
      "launch": [-2.0, -7.8],
      "airborne": true,
      "turn": false,
      "transitions": [
        { "when": "nearGround", "to": "land" },
        { "when": "animEnd", "to": "jump_back_air" },
        { "when": "landed", "to": "idle" }
      ]
    },
    "jump_back_air": {
      "anim": "jump_spin_back",
      "airborne": true,
      "turn": false,
      "transitions": [
        { "when": "nearGround", "to": "land" },
        { "when": "animEnd", "to": "fall" },
        { "when": "landed", "to": "idle" }
      ]
    },
    "jump_up_fall": {
      "anim": "jump_up_fall",
      "airborne": true,
      "turn": false,
      "transitions": [
        { "when": "nearGround", "to": "land" },
        { "when": "landed", "to": "idle" }
      ]
    },
    "fall": {
      "anim": "fall",
      "airborne": true,
      "turn": false,
      "transitions": [
        { "when": "nearGround", "to": "land" },
        { "when": "landed", "to": "idle" }
      ]
    },
    "land": {
      "anim": "land",
      "airborne": true,
      "turn": false,
      "transitions": [
        { "when": "landed", "to": "idle" }
      ]
    }
  }
}
