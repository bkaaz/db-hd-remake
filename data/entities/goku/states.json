{
  "initial": "idle",
  "onGotHit": "hurt",
  "onGuard": "guard_hit",
  "states": {
    "idle": {
      "anim": "idle",
      "vel": [0, 0],
      "turn": true,
      "transitions": [
        { "when": "pressed:light", "to": "punch" },
        { "when": "pressed:medium", "to": "kick_mid" },
        { "when": "pressed:heavy", "to": "kick_high" },
        { "when": "held:fwd", "to": "walk_fwd" },
        { "when": "held:back", "to": "walk_back" },
        { "when": "held:up", "to": "jump_up" },
        { "when": "held:down", "to": "crouch" }
      ]
    },
    "walk_fwd": {
      "anim": "walk",
      "vel": [1.4, 0],
      "turn": true,
      "transitions": [
        { "when": "pressed:light", "to": "punch" },
        { "when": "pressed:medium", "to": "kick_mid" },
        { "when": "pressed:heavy", "to": "kick_high" },
        { "when": "held:up", "to": "jump_fwd" },
        { "when": "!held:fwd", "to": "idle" },
        { "when": "held:down", "to": "crouch" }
      ]
    },
    "walk_back": {
      "anim": "walk",
      "vel": [-1.0, 0],
      "turn": true,
      "transitions": [
        { "when": "pressed:light", "to": "punch" },
        { "when": "pressed:medium", "to": "kick_mid" },
        { "when": "pressed:heavy", "to": "kick_high" },
        { "when": "held:up", "to": "jump_back" },
        { "when": "!held:back", "to": "idle" },
        { "when": "held:down", "to": "crouch" }
      ]
    },
    "punch": {
      "anim": "punch",
      "vel": [0, 0],
      "turn": false,
      "onHit": "hurt",
      "damage": 6,
      "sound": "swing_1",
      "hitSound": "hit_1",
      "blockSound": "block_1",
      "transitions": [
        { "when": "animEnd", "to": "idle" }
      ]
    },
    "kick_mid": {
      "anim": "kick_mid",
      "vel": [0.4, 0],
      "turn": false,
      "onHit": "hurt",
      "damage": 7,
      "sound": "swing_2",
      "hitSound": "hit_1",
      "blockSound": "block_1",
      "transitions": [
        { "when": ["hitConfirmed", "pressed:medium"], "to": "kick_high_chain" },
        { "when": "animEnd", "to": "idle" }
      ]
    },
    "uppercut": {
      "anim": "uppercut",
      "vel": [0, 0],
      "turn": false,
      "onHit": "knockdown",
      "damage": 14,
      "sound": "swing_3",
      "hitSound": "hit_2",
      "blockSound": "block_1",
      "hitFx": "spark_2",
      "transitions": [
        { "when": "animEnd", "to": "idle" }
      ]
    },
    "kick_high": {
      "anim": "kick_high",
      "vel": [0, 0],
      "turn": false,
      "onHit": "hurt_heavy",
      "damage": 12,
      "sound": "swing_3",
      "hitSound": "hit_2",
      "blockSound": "block_1",
      "hitFx": "spark_2",
      "transitions": [
        { "when": "animEnd", "to": "idle" }
      ]
    },
    "kick_high_chain": {
      "anim": "kick_high",
      "vel": [0.4, 0],
      "turn": false,
      "onHit": "hurt",
      "damage": 9,
      "sound": "swing_3",
      "hitSound": "hit_2",
      "blockSound": "block_1",
      "hitFx": "spark_2",
      "transitions": [
        { "when": ["hitConfirmed", "pressed:medium"], "to": "kick_low" },
        { "when": "animEnd", "to": "idle" }
      ]
    },
    "kick_low": {
      "anim": "kick_low",
      "vel": [0.4, 0],
      "turn": false,
      "onHit": "knockdown_sweep",
      "damage": 10,
      "sound": "swing_3",
      "hitSound": "hit_2",
      "blockSound": "block_1",
      "hitFx": "spark_2",
      "transitions": [
        { "when": "animEnd", "to": "idle" }
      ]
    },
    "crouch": {
      "anim": "crouch",
      "vel": [0, 0],
      "turn": true,
      "transitions": [
        { "when": "pressed:medium", "to": "kick_crouch" },
        { "when": "pressed:heavy", "to": "uppercut" },
        { "when": "!held:down", "to": "idle" }
      ]
    },
    "kick_crouch": {
      "anim": "kick_crouch",
      "vel": [0, 0],
      "turn": false,
      "onHit": "hurt",
      "damage": 7,
      "sound": "swing_2",
      "hitSound": "hit_1",
      "blockSound": "block_1",
      "transitions": [
        { "when": "animEnd", "to": "crouch" }
      ]
    },
    "kick_air": {
      "anim": "kick_air",
      "airborne": true,
      "turn": false,
      "onHit": "hurt",
      "damage": 8,
      "sound": "swing_2",
      "hitSound": "hit_1",
      "blockSound": "block_1",
      "transitions": [
        { "when": "landed", "to": "idle" },
        { "when": "nearGround", "to": "land" },
        { "when": "animEnd", "to": "fall" }
      ]
    },
    "hurt": {
      "anim": "hurt",
      "vel": [-1.4, 0],
      "turn": false,
      "sound": "voice_hurt",
      "ifAirborne": "hurt_air",
      "transitions": [
        { "when": "animEnd", "to": "idle" }
      ]
    },
    "hurt_air": {
      "anim": "hurt_air",
      "launch": [-1.2, -1.0],
      "airborne": true,
      "turn": false,
      "sound": "voice_hurt",
      "transitions": [
        { "when": "landed", "to": "idle" },
        { "when": "nearGround", "to": "land" },
        { "when": "animEnd", "to": "fall" }
      ]
    },
    "guard_hit": {
      "anim": "guard_hit",
      "vel": [-2.0, 0],
      "turn": false,
      "transitions": [
        { "when": "animEnd", "to": "idle" }
      ]
    },
    "hurt_heavy": {
      "anim": "hurt_heavy",
      "vel": [-5.2, 0],
      "turn": false,
      "sound": "voice_hurt",
      "ifAirborne": "hurt_heavy_air",
      "transitions": [
        { "when": "animEnd", "to": "idle" }
      ]
    },
    "hurt_heavy_air": {
      "anim": "knockdown",
      "launch": [-3.5, -2.5],
      "airborne": true,
      "turn": false,
      "sound": "voice_hurt",
      "transitions": [
        { "when": "landed", "to": "bounce" }
      ]
    },
    "knockdown": {
      "anim": "knockdown",
      "launch": [-1.0, -6.2],
      "airborne": true,
      "turn": false,
      "sound": "voice_hurt",
      "ifAirborne": "knockdown_air",
      "transitions": [
        { "when": "landed", "to": "bounce" }
      ]
    },
    "knockdown_sweep": {
      "anim": "knockdown",
      "launch": [-4.5, -3.2],
      "airborne": true,
      "turn": false,
      "sound": "voice_hurt",
      "ifAirborne": "knockdown_air",
      "transitions": [
        { "when": "landed", "to": "bounce" }
      ]
    },
    "knockdown_air": {
      "anim": "knockdown",
      "launch": [-2.0, -4.5],
      "airborne": true,
      "turn": false,
      "sound": "voice_hurt",
      "transitions": [
        { "when": "landed", "to": "bounce" }
      ]
    },
    "bounce": {
      "anim": "bounce",
      "launch": [-0.7, -2.4],
      "airborne": true,
      "turn": false,
      "sound": "land_2",
      "transitions": [
        { "when": "landed", "to": "downed" }
      ]
    },
    "downed": {
      "anim": "downed",
      "vel": [0, 0],
      "turn": false,
      "sound": "land_3",
      "transitions": [
        { "when": "animEnd", "to": "getup" }
      ]
    },
    "getup": {
      "anim": "getup",
      "vel": [0, 0],
      "turn": false,
      "transitions": [
        { "when": "animEnd", "to": "idle" }
      ]
    },
    "jump_up": {
      "anim": "jump_up",
      "launch": [0, -7.8],
      "airborne": true,
      "turn": false,
      "transitions": [
        { "when": "pressed:medium", "to": "kick_air" },
        { "when": "nearGround", "to": "land" },
        { "when": "falling", "to": "jump_up_fall" },
        { "when": "landed", "to": "idle" }
      ],
      "sound": "jump_1"
    },
    "jump_fwd": {
      "anim": "jump_fwd",
      "launch": [2.3, -7.8],
      "airborne": true,
      "turn": false,
      "transitions": [
        { "when": "pressed:medium", "to": "kick_air" },
        { "when": "nearGround", "to": "land" },
        { "when": "animEnd", "to": "jump_fwd_air" },
        { "when": "landed", "to": "idle" }
      ],
      "sound": "jump_1"
    },
    "jump_fwd_air": {
      "anim": "jump_spin",
      "airborne": true,
      "turn": false,
      "transitions": [
        { "when": "pressed:medium", "to": "kick_air" },
        { "when": "nearGround", "to": "land" },
        { "when": "animEnd", "to": "fall" },
        { "when": "landed", "to": "idle" }
      ]
    },
    "jump_back": {
      "anim": "jump_back",
      "launch": [-2.0, -7.8],
      "airborne": true,
      "turn": false,
      "transitions": [
        { "when": "pressed:medium", "to": "kick_air" },
        { "when": "nearGround", "to": "land" },
        { "when": "animEnd", "to": "jump_back_air" },
        { "when": "landed", "to": "idle" }
      ],
      "sound": "jump_1"
    },
    "jump_back_air": {
      "anim": "jump_spin_back",
      "airborne": true,
      "turn": false,
      "transitions": [
        { "when": "pressed:medium", "to": "kick_air" },
        { "when": "nearGround", "to": "land" },
        { "when": "animEnd", "to": "fall" },
        { "when": "landed", "to": "idle" }
      ]
    },
    "jump_up_fall": {
      "anim": "jump_up_fall",
      "airborne": true,
      "turn": false,
      "transitions": [
        { "when": "pressed:medium", "to": "kick_air" },
        { "when": "nearGround", "to": "land" },
        { "when": "landed", "to": "idle" }
      ]
    },
    "fall": {
      "anim": "fall",
      "airborne": true,
      "turn": false,
      "transitions": [
        { "when": "pressed:medium", "to": "kick_air" },
        { "when": "nearGround", "to": "land" },
        { "when": "landed", "to": "idle" }
      ]
    },
    "land": {
      "anim": "land",
      "airborne": true,
      "turn": false,
      "transitions": [
        { "when": "landed", "to": "idle" }
